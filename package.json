{
  "name": "@dshrb/root",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "DSH Reviewer Bot — native DeepSeek Harness plugin suite for code review across forges",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "packages/*/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e-install-modes.mjs",
    "lint": "oxlint .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "clean": "rm -rf packages/*/*/lib",
    "build:release": "node scripts/build-release.mjs",
    "probe": "pnpm --filter @dshrb/signature-probe run check"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@types/node": "24.3.0",
    "esbuild": "0.28.2",
    "oxlint": "1.9.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
