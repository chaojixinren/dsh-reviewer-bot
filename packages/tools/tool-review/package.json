{
  "name": "@dshrb/tool-review",
  "version": "0.1.0",
  "type": "module",
  "description": "Model-facing review tools registered on ctx.tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaojixinren/dsh-reviewer-bot.git",
    "directory": "packages/tools/tool-review"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
